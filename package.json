{
  "name": "smart-invitation-saas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @smart-invitation/web",
    "dev:web": "npm run dev --workspace @smart-invitation/web",
    "dev:api": "npm run dev --workspace @smart-invitation/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @smart-invitation/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @smart-invitation/api",
    "prisma:studio": "npm run prisma:studio --workspace @smart-invitation/api"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
