# INVITE STUDIO - Monorepo Environment Variables Reference
# Copy apps/api/.env.example to apps/api/.env
# Copy apps/web/.env.example to apps/web/.env

# Node & Database
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invite_studio?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/invite_studio?schema=public"

# Cross-Origin Deployment Config
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

