# Environment Configuration
NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invite_studio?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/invite_studio?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_a_64_char_secure_random_key_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_64_char_secure_random_key_for_refresh_tokens
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# OTP Provider Configuration
# Set to 'true' only during local development. In production, this MUST be false or unset.
ENABLE_DEMO_OTP=true
DEMO_OTP=12345
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Storage & Payment Placeholders
STORAGE_PROVIDER=local
PAYMENT_PROVIDER=test
