# Environment Configuration
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (e.g. https://your-domain.vercel.app,https://staging.your-domain.vercel.app)
APP_ORIGIN=http://localhost:3000
# Set to 'true' if you want Vercel preview branch deployments (*.vercel.app) to be permitted by CORS
ALLOW_VERCEL_PREVIEWS=false
# Base URL of the backend API (used for absolute asset URLs and fallback webhooks, e.g. https://invite-studio-api.onrender.com)
API_ORIGIN=http://localhost:5000

# PostgreSQL Database Connection (Supabase Transaction Pooler / Session Pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invite_studio?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/invite_studio?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_a_64_char_secure_random_key_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_64_char_secure_random_key_for_refresh_tokens
ACCESS_TOKEN_EXPIRES_IN=60m
REFRESH_TOKEN_EXPIRES_IN=7d

# OTP Provider Configuration
# Set to 'true' only during local development. In production, this is automatically forced to false.
ENABLE_DEMO_OTP=true
DEMO_OTP=12345
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Mobile SMS Gateway (Required only for production SMS delivery to phone numbers; otherwise users sign in via Brevo Email OTP)
# Supported options: twilio, msg91, fast2sms
SMS_PROVIDER=
SMS_API_KEY=
TWILIO_AUTH_TOKEN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Storage Configuration (Supabase Storage for production cloud persistence)
# Set STORAGE_PROVIDER=supabase for production cloud storage
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=invitations

# Payment Configuration (Razorpay)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Brevo SMTP Email Configuration (Primary verification in production)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASS=YOUR_BREVO_SMTP_KEY
SMTP_FROM_NAME=INVITE STUDIO
SMTP_FROM_EMAIL=YOUR_VERIFIED_SENDER_EMAIL

