a:["$","div",null,{"className":"p-8 rounded-3xl bg-white border border-[#E9DED1] shadow-xs space-y-6 text-sm text-[#57464E] leading-relaxed","children":[["$","section",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"font-serif font-bold text-xl text-[#34232B]","children":"1. Our Core Privacy Philosophy"}],["$","p",null,{"children":"At INVITE STUDIO, we believe that celebratory invitations should bring people together without compromising the privacy of hosts or their guests. We do not sell guest data, run third-party advertising trackers, or expose cross-guest RSVP lists."}]]}],["$","section",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"font-serif font-bold text-xl text-[#34232B]","children":"2. Strict Aggregate RSVP Protection"}],["$","p",null,{"children":"By default, INVITE STUDIO strictly enforces aggregate attendance reporting. Individual guest RSVP responses (Attending vs. Not Attending) are aggregated into overall counts for the host, ensuring guests can respond honestly without fear of social scrutiny or public tracking."}]]}],["$","section",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"font-serif font-bold text-xl text-[#34232B]","children":"3. Information We Collect"}],["$","ul",null,{"className":"list-disc pl-5 space-y-1 text-xs","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Host Account Information:"}]," Mobile phone number, full name, email address, and authentication credentials via one-time passwords (OTP)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Guest List Information:"}]," Names, WhatsApp phone numbers, and optional relations/addresses uploaded or entered by the host to generate personal invitation links."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Event Information:"}]," Event titles, occasion types, dates, times, and venue locations provided by the host."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Payment Information:"}]," Transaction identifiers and payment status processed securely through RBI-compliant Indian payment gateways (Razorpay). We never store raw credit/debit card details or banking passwords."]}]]}]]}],["$","section",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"font-serif font-bold text-xl text-[#34232B]","children":"4. How Information is Used"}],["$","p",null,{"children":"Guest phone numbers and names are used solely to allow hosts to generate personalized digital invitation links and dispatch messages via WhatsApp click-to-chat. We do not send unsolicited promotional messages to your guests."}]]}],["$","section",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"font-serif font-bold text-xl text-[#34232B]","children":"5. Data Isolation & Security"}],["$","p",null,{"children":"All host datasets are isolated by tenant identifier within PostgreSQL with row-level segregation. Cryptographic hashes protect access tokens and invitation links are non-sequential and mathematically unguessable."}]]}],["$","section",null,{"className":"space-y-2","children":[["$","h2",null,{"className":"font-serif font-bold text-xl text-[#34232B]","children":"6. Contact Privacy Team"}],["$","p",null,{"children":["For inquiries regarding data erasure, account deletion, or privacy governance, please submit a support ticket from your host dashboard or contact ",["$","span",null,{"className":"font-mono text-[#401526]","children":"support@invitestudio.in"}],"."]}]]}]]}]
